<%= stylesheet_link_tag "simple" %>
<h1>Book a flight</h1>

<% flash.each do |type, msg| %>
  <div class="notice <%= type %>">
    <% msg.split("\n").each do |s| %>
      <h5><%= s %></h5>
    <% end %>
  </div>
<% end %>
<% if @flight %>
  <%= form_with model: @booking do |form| %>
    <h2><%= @flight.summary %></h2>
    <%= render @flight %>
    <%= form.fields_for :passengers, include_id: false do |form_passenger| %>
      <h5>Passenger (leave blank if not applicable)</h5>
      <%= form.hidden_field :flight_id, value: @flight.id %>
      <%= form.label :name %>
      <%= form_passenger.text_field :name %>
      <%= form.label :email, "Primary contact email" %>
      <%= form_passenger.email_field :email %>
    <% end %>
    <%= form.submit "Book this flight" %>
  <% end %>
<% end %>
